{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["core/**/*.js", "server/**/*.js", "public/src/**/*.js", "scripts/**/*.mjs", "test/**/*.mjs"],
  "exclude": ["node_modules", "dist"]
}
