{
  "name": "greyhaven-detective",
  "version": "0.1.0",
  "description": "Greyhaven — a 3D noir detective game where every character is played by Claude and the case reacts to how you investigate.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "playtest": "node scripts/playtest.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "n8ao": "^2.0.2",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "fbx2gltf": "^0.9.7-p1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
